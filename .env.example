# Copy this to .env at project root. Never commit .env to GitHub.
# Generate random keys:
#   openssl rand -base64 48  (for JWT_SECRET)
#   openssl rand -base64 32  (for HEALTH_ENCRYPTION_KEY_V1)

# === REQUIRED SECRETS ===
JWT_SECRET=super_secret_jwt_key_at_least_48_characters_long_for_security
HEALTH_ENCRYPTION_KEY_V1=32_byte_base64_encoded_key_here_for_health_data

# === DATABASE (Optional: Leave empty for high-speed in-memory store) ===
DATABASE_URL=postgresql://vyra_user:password@localhost:5432/vyra_db

# === GEMINI AI (Get key from Google AI Studio: https://aistudio.google.com) ===
# Master fallback key:
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Separate keys per feature so quota and limits are completely isolated:
GEMINI_RECIPE_API_KEY=optional_separate_key_for_ai_recipes
GEMINI_FOOD_API_KEY=optional_separate_key_for_food_photo_scan
GEMINI_LAB_API_KEY=optional_separate_key_for_blood_lab_report_scan
GEMINI_CHAT_API_KEY=optional_separate_key_for_coach_chat
GEMINI_EVENTS_API_KEY=optional_separate_key_for_events_discovery

# === SERVER CONFIG ===
PORT=4000
NODE_ENV=development

# === CORS & SECURITY ===
ALLOWED_ORIGINS=http://localhost:3000,https://vyra-api.onrender.com

# === RATE LIMITS ===
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AI_PER_HOUR=25
TRUSTED_PROXY_COUNT=1
